# Порт сервера
PORT=3000

# На каком интерфейсе слушать. За reverse-proxy (Caddy/nginx) — 127.0.0.1
# HOST=127.0.0.1

# Куда складывать базу и фото (по умолчанию ./data)
# DATA_DIR=./data

# Часовой пояс — важно для смены "дня" в полночь по вашему времени
TZ=Europe/Moscow

# Максимум аккаунтов (после — регистрация закрывается)
MAX_USERS=4

# Код-приглашение для регистрации (если задан — требуется всегда)
# INVITE_CODE=secret123

# Подсчёт калорий и веса по фото через Claude API (необязательно).
# Без ключа всё работает, калории вводятся вручную.
# ANTHROPIC_API_KEY=sk-ant-...
# Модель для анализа фото. По умолчанию claude-opus-4-8 (точнее всего).
# Дешевле и быстрее: claude-haiku-4-5
# AI_MODEL=claude-opus-4-8

# 🇸🇰 Словацкий: ИИ-репетитор, кнопка «🤖 Почему?» и озвучка — через ChatGPT (необязательно).
# Ключ: https://platform.openai.com/api-keys. Без ключа курс и повторение работают,
# озвучка — только если в системе есть словацкий голос.
# OPENAI_API_KEY=sk-...
# Модель для чата (по умолчанию gpt-4.1-mini) и для озвучки (по умолчанию gpt-4o-mini-tts)
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Лимит запросов к ИИ на человека в день — защита баланса (по умолчанию 150)
# AI_DAILY_LIMIT=150
